```sql
CREATE TABLE products (
    id SERIAL PRIMARY KEY,
    name VARCHAR(100) NOT NULL,
    price NUMERIC(10, 2) NOT NULL
);

INSERT INTO products (name, price)
VALUES ('Laptop', 25000.00);

SELECT id, name, price
FROM products
WHERE price > 10000;
```

